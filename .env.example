# ---------------------------------------------------------------------------
# Firebase web config (public by design — these ship in the client bundle).
# Firebase console → Project settings → Your apps → Web app.
# ---------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Feature flag: the end-of-day email (§9). Off by default, and even when on it
# is still gated per-user by prefs.emailCheckInOptIn.
VITE_ENABLE_EMAIL_CHECKIN=false

# ---------------------------------------------------------------------------
# Server-only. Never prefixed with VITE_ — these must not reach the browser.
# ---------------------------------------------------------------------------

# Firebase Admin service account. Firebase console → Project settings →
# Service accounts → Generate new private key. Paste the whole JSON on one
# line, or set FIREBASE_PRIVATE_KEY separately with \n escapes intact.
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Resend — https://resend.com/api-keys. Free tier: 3,000/mo, 100/day.
RESEND_API_KEY=
RESEND_FROM="tradetrl <onboarding@resend.dev>"

# Shared secret Vercel Cron presents as `Authorization: Bearer <CRON_SECRET>`.
# Vercel sets this automatically for cron invocations when defined in project
# env; set it so the route cannot be triggered by anyone with the URL.
CRON_SECRET=

# Public origin, used for links inside the email.
APP_URL=https://your-app.vercel.app

# Where user feedback and ideas are emailed. Defaults to joestaxk@gmail.com.
ADMIN_EMAIL=

# ---------------------------------------------------------------------------
# Telegram support. Preferred over email: no domain, no DNS, no verification,
# and it arrives as a push notification.
#   TELEGRAM_BOT_TOKEN  from @BotFather after /newbot
#   TELEGRAM_CHAT_ID    your own numeric id — message the bot once, then open
#                       https://api.telegram.org/bot<TOKEN>/getUpdates
#   VITE_TELEGRAM_HANDLE  public username for the "message us" link (no @)
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
VITE_TELEGRAM_HANDLE=
